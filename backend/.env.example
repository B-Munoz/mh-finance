# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# PostgreSQL connection URLs (required for Railway; local dev uses users.toml)
MH_NEON_DB_URL=
MH_PACHI_DB_URL=

# Plain-text passwords (override settings.toml values for production)
MH_NEON_PASSWORD=
MH_PACHI_PASSWORD=

# Vercel frontend URL (for CORS) — set after Vercel deployment
FRONTEND_URL=
